{
  "name": "teseracto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ocr": "jest --runInBand --testTimeout=900000 --passWithNoTests --testMatch \"<rootDir>/test-support/receipts/accuracy.ocr.ts\"",
    "test:cy": "cypress run --component",
    "fixtures:receipts": "node test-support/receipts/generateSyntheticReceipts.mjs",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@reduxjs/toolkit": "2.13.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "date-fns": "4.4.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@napi-rs/canvas": "1.0.9",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "baseline-browser-mapping": "2.11.26",
    "cypress": "16.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  }
}
